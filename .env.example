# 本地开发环境配置示例

# 语音对话
# AI对话开关：AI就绪之前保持 false，只开放 TTS/ASR；准备好后改为 true
VOICE_AI_ENABLED=false
# faster-whisper 模型大小: tiny/base/small/medium/large-v3
ASR_MODEL_SIZE=base
# auto/cpu/cuda
ASR_DEVICE=auto
# int8 适合CPU, float16 适合GPU
ASR_COMPUTE_TYPE=int8
# edge-tts 发音人（TTS 需联网）
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 语速，如 +10%
TTS_RATE=+0%

# 本地大模型（Ollama，启用 AI 对话时需要）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
