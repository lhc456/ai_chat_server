# 本地开发环境配置示例

# 语音对话
# AI对话开关：AI就绪之前保持 false，只开放 TTS/ASR；准备好后改为 true
VOICE_AI_ENABLED=false
# faster-whisper 模型大小: tiny/base/small/medium/large-v3
ASR_MODEL_SIZE=base
# auto/cpu/cuda
ASR_DEVICE=auto
# int8 适合CPU, float16 适合GPU
ASR_COMPUTE_TYPE=int8
# edge-tts 发音人（TTS 需联网）
# 想要活泼对话感：zh-CN-XiaoyiNeural（默认） / zh-CN-YunxiNeural（阳光男声） / zh-CN-YunxiaNeural（少年音）
# 想要播音腔：zh-CN-XiaoxiaoNeural
TTS_VOICE=zh-CN-XiaoyiNeural
# 语速：+10% 更像日常聊天，+0% 偏播报感
TTS_RATE=+10%
# 音调：+5Hz 轻快一些，+0Hz 恢复默认
TTS_PITCH=+5Hz

# 本地大模型（Ollama，启用 AI 对话时需要）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
